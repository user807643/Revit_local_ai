<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2026 ships on .NET 8 (verified against RevitAPI.dll: .NETCoreApp,Version=v8.0) -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- UseWPF подключает PresentationCore, PresentationFramework, WindowsBase и System.Xaml. -->
    <UseWPF>true</UseWPF>
    <AssemblyName>RevitAISchedule</AssemblyName>
    <RootNamespace>RevitAISchedule</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Revit 2026 — только 64-разрядная версия. -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <!-- Исходники сохраняются в UTF-8; задаём кодировку явно для всех платформ сборки. -->
    <CodePage>65001</CodePage>
    <!-- System.Text.Json ships with the .NET 8 shared framework that Revit 2026 already loads. -->
    <NoWarn>$(NoWarn);CS1591;MSB3277;MSB3243</NoWarn>
  </PropertyGroup>

  <!-- Revit 2026 API assemblies. CopyLocal=false: Revit loads its own copies at run time. -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>


  <!-- Манифест аддина. Копируется Install-Plugin.ps1 в корень Addins\2026. -->
  <ItemGroup>
    <None Include="RevitAISchedule.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>